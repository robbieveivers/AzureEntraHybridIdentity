{
    "name": "AzureEntraHybridIdentity Dev Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "files.eol": "\n",
                "editor.formatOnSave": true,
                "editor.insertSpaces": true,
                "editor.tabSize": 2
            },
            "extensions": [
                "ms-azuretools.vscode-azurecli",
                "hashicorp.terraform",
                "redhat.ansible",
                "editorconfig.editorconfig",
                "davidanson.vscode-markdownlint"
            ]
        }
    },
    "postCreateCommand": "echo '✅ Tools installed:' && ansible --version && echo '' && terraform --version && echo '' && az --version",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    }
}
